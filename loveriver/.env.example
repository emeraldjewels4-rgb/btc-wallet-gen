# Copy to loveriver/.env (git-ignored) and fill in.

# BNB Smart Chain RPC endpoint. Any provider works; a local node is fine too.
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Funded wallet that deploys the contract, pays gas and holds the supply
# before distribution. Either the plaintext key (0x...) or the path to a
# keystore written by: npm run keystore -- encrypt-treasury
# Leave it empty to use wallets/treasury.keystore.json when that file exists.
# Never commit this.
TREASURY_PRIVATE_KEY=
