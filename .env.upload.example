[TEMPLATE]
# Copy to .env.upload (git-ignored), fill in the SFTP account from the hosting
# control panel, then run: node upload.mjs
#
# upload.mjs reads this file itself; these values are never passed on the
# command line and the password is never printed. Upload only the generated
# page: the script cannot send anything else.

# SFTP server for your account. In cPanel this is under FTP Accounts; the
# hostname is often the server name rather than your domain.
SFTP_HOST=ftp.example.com

# Usually the full cPanel/FTP username, e.g. web9999 or user@example.com.
SFTP_USER=replace-me

SFTP_PASSWORD=replace-me

# Optional. 22 is the default; some shared hosts use 2222 or another port.
# SFTP_PORT=22

# Optional. Directory the page is written into, relative to the login root.
# SFTP_REMOTE_DIR=public_html

# Optional. Public URL of the uploaded page. When set, upload.mjs fetches it back
# after a live upload and fails unless the served size and <title> match, which
# is how the weekly publish checks itself without an extra flag.
# SFTP_PUBLIC_URL=https://example.com/index.html
