# Treasury key and local state - never commit these.
.env
refill-audit.jsonl
sepolia-call-audit.jsonl
*.jsonl.lock
*.jsonl.append-lock
*.jsonl.state.json
site/
.env.upload
.treasury-summary-state.json
.treasury-summary-skip-day.txt
.treasury-weekly-state.json
.treasury-monthly-state.json
summary-wallets.txt
treasury-weekly.log
treasury-monthly.log
treasury-summary.log
node_modules/

# Seed-phrase backups written inside the repo, e.g. the README's
# `node wallet.mjs --phrase-only > seed.txt`. The bare names are anchored to the
# root with a leading slash so a fixture at test/fixtures/seed.txt is still
# tracked; the *.seed.txt suffix catches copies made anywhere.
/seed.txt
/seed-phrase.txt
/seedphrase.txt
/mnemonic.txt
*.seed.txt
